# Telegram API Credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=                   # Format: +1234567890

# Telegram Bot Configuration
BOT_TG_HANDLE=solana_trojanbot    # Telegram handle of the trading bot
RECIPIENT_IDS=                    # Your Telegram user ID for notifications

# Token Monitoring Settings
TOKEN_AGE_MINUTES=0.3            # How old tokens can be to be considered (in minutes)
WAIT_SECONDS=2                   # Base wait time between checks
MAX_TOKEN_RETRIES=3              # Maximum number of purchase attempts per token

# API Keys
BITQUERY_API_TOKEN=              # Get from https://graphql.bitquery.io
SOLSCAN_API_KEY=                 # Get from https://public-api.solscan.io

# Market Settings
MIN_MCAP_THRESHOLD=5000          # Minimum market cap (divided by 10^10 for actual value)

# Feature Toggles
ENABLE_JUPITER=false             # Enable Jupiter verified token monitoring
ENABLE_PUMP=false               # Enable pump token monitoring
ENABLE_SOLWATCH=true            # Enable SolWatch token monitoring

# Solana Network Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_WS=wss://your-rpc-endpoint     # WebSocket endpoint
SOLANA_MAINNET_HTTP=https://your-rpc-endpoint  # HTTP RPC endpoint
TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA 
TOKEN_SELECTION_MODE=pump # pump, non-pump, all

# Token Filtering Configuration
MIN_SUPPLY=10000  # Minimum token supply to consider